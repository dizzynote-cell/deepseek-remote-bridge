# DeepSeek Remote Bridge — local configuration (copy to config/.env).
# Everything is optional except DSH_EXE / DSH_CLI, which must point at your own
# DeepSeek Harness installation. Values here override the built-in defaults.

# --- web -------------------------------------------------------------------
DSH_BRIDGE_HOST=127.0.0.1
DSH_BRIDGE_PORT=8766
# Mount the page under a prefix, for example /dsh/ (keep the trailing slash).
DSH_BRIDGE_BASE_PATH=/
DSH_BRIDGE_SITE_TITLE=DeepSeek Remote Bridge
DSH_BRIDGE_SITE_SUBTITLE=网页、飞书与主机统一协作

# --- DeepSeek Harness installation -----------------------------------------
# Absolute path to the desktop executable. If omitted, common install
# locations are probed and a clear error is printed when nothing is found.
DSH_EXE=
# Absolute path to the CLI entry inside the installed package:
# <install dir>\resources\app.asar\dsh\node_modules\@deepseek-ai\dsh-desktop-host\lib\cli.js
DSH_CLI=
# Leave DSH_HOME empty to use the harness' own default profile data directory
# (the same store the desktop app uses, which is what makes real sessions
# visible). Set it only for an isolated test store.
DSH_HOME=

# --- model route -----------------------------------------------------------
DSH_BRIDGE_PROVIDER=deepseek-account
DSH_BRIDGE_MODEL=deepseek-flash
# Optional reasoning effort id, for example high or max. Empty keeps the model default.
DSH_BRIDGE_REASONING_EFFORT=
# Optional output token cap; 0 keeps the adapter default.
DSH_BRIDGE_MAX_TOKENS=0
# Permission preset for new sessions: workspace-write or danger-full-access.
DSH_BRIDGE_PERMISSION_PRESET=workspace-write

# --- workspaces ------------------------------------------------------------
# Directories the page may create sessions in. Empty values default to
# <user home>\DSH-Bridge\projects and <user home>\DSH-Bridge\sessions.
DSH_BRIDGE_PROJECTS_ROOT=
DSH_BRIDGE_STANDALONE_DIR=
# Bridge state (tokens, generated patch, logs, uploads). Defaults to ./state.
DSH_BRIDGE_HOME=

# --- limits ----------------------------------------------------------------
DSH_BRIDGE_ATTACHMENT_MAX_BYTES=10485760
DSH_BRIDGE_ATTACHMENT_BATCH_MAX_BYTES=31457280
DSH_BRIDGE_APPROVAL_TIMEOUT_MS=900000
DSH_BRIDGE_QUESTION_TIMEOUT_MS=900000

# --- optional modes --------------------------------------------------------
# Voice is off by default. Set 1 plus a credentials file to enable the read-aloud
# buttons; the bridge reads the key locally and never sends it to the browser.
DSH_BRIDGE_VOICE=0
VOLC_TTS_ENV_FILE=
DSH_BRIDGE_FEISHU=false
DSH_BRIDGE_CLOUD=false

# --- entry-page switch (optional) -----------------------------------------
# Point this at the other bridge's page to enable the second entry in the
# top-left logo menu. Leave it empty and the entry stays disabled.
DSH_BRIDGE_SIBLING_PROVIDER=codex
DSH_BRIDGE_SIBLING_NAME=Codex
DSH_BRIDGE_SIBLING_URL=
